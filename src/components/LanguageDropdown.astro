---
import { t, l } from "astro-i18n";

const changeLangHref = (langCode: string) => l(Astro.url.pathname, undefined, {targetLocale: langCode});

export const locales = ["en", "fr", "es", "ja", "hi"]

--- 
<div class="dropdown-wrapper">
    <button type="button">
        <img src="/assets/img/icons/globe-white.svg" alt="change language">
    </button>
    <div class="dropdown language-links">
        {locales.map((locale) => 
            <a href={changeLangHref(locale)} onclick={"setNavLang('" + locale + "');"}>
                {t("common.lang-display-name", undefined, {"locale": locale})}
            </a>
        )}
    </div>
</div>
<style>
    .dropdown-wrapper {
        --rgb-bg: black;
        --rgb-text: white;

        position: relative;

        & div.dropdown {
            transition: ease-in-out 0.15s;
            font-size: 0rem;
            filter: opacity(0);
            width: max-content;
            line-height: 1.5em;
            display: flex;
            flex-direction: column;
            position: absolute;
            top: 0em;
            background-color: var(--rgb-bg);
            outline: 0.1em var(--rgb-text) solid;
            padding: 0.5em;
            z-index: 99;
            
            & a {
                all: unset;
                cursor: pointer;
                &:hover {
                transform: scale(1.1);
                text-decoration: underline var(--rgb-text) 0.1rem solid;
                }
            }
        }
        & button {
            display: flex; justify-content: center; align-items: center;
            outline: 0.1em var(--rgb-text) solid;
            padding: 0.5em;
            &:hover {
                transform:scale(1.1);
            }
        }

        & button:focus + div.dropdown, div.dropdown:focus-within {
            font-size: 1rem;
            filter: opacity(100);
        }
        
    }  

    @media not all and (min-resolution:.001dpcm)
        { @supports (-webkit-appearance:none) {
            div.dropdown {
                font-size: 1rem !important;
            }
        }}
</style>

<script is:inline defer>

function setNavLang(language) {
    localStorage.setItem("preferred-navigation-language", language);
    return false; // prevent default
}

// add Event Listener to ensure focus on click for mobile devices
const navButtons = document.querySelectorAll("nav .dropdown-wrapper > button")
for (let navButton of navButtons) {
    navButton.addEventListener("click", (e) => {
        navButton.focus();
    })
}

const browserIsSafari = /^((?!chrome|android).)*safari/i.test(navigator.userAgent);
if (browserIsSafari) {
    const dropdowns = document.querySelectorAll("div.dropdown-wrapper > .dropdown");
    for (let dropdown of dropdowns) {
        dropdown.style.fontSize = '1rem';
    }
}

</script>