---
import { l, t } from 'astro-i18n'
import LanguageDropdown from '../components/LanguageDropdown.astro';

import imgBirbFavicon from "../../public/assets/img/birbs/favicon.png"
import imgHomeIcon from "../../public/assets/img/icons/home-white.svg"

interface Props {
  webpTitle?: string;
  title?: string; 
}
const { webpTitle, title } = Astro.props;
---
<html lang={t("common.lang")}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href={imgBirbFavicon.src} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{webpTitle ?? t("birb.webp-title")}</title>
	</head>
    <body>
        <header>
            {title ? 
                <div class="heading-wrapper">
                    <img class="inline-icon" src={imgBirbFavicon.src} alt="bird icon">
                    <h1>   
                        {title}
                    </h1>
                </div>
            : null }
            <nav>
                <LanguageDropdown />
                <a href={l("/")} class="button-like" role="link">
                    <img src={imgHomeIcon.src} alt="home icon" />
                </a>
            </nav>
        </header>
        <main>
            <slot />
        </main>
        <footer>
        </footer>
    </body>
</html>
<style is:global>
    @font-face {
        font-family: Kalam;
        src: url("../../public/assets/fonts/Kalam/Kalam-Regular.ttf");
    }
    @font-face {
        font-family: Kalam;
        font-weight: bold;
        src: url("../../public/assets/fonts/Kalam/Kalam-Bold.ttf");
    }
    @font-face {
        font-family: Kalam;
        font-weight: lighter;
        src: url("../../public/assets/fonts/Kalam/Kalam-Light.ttf");
    }
    html {
		--rgb-bg-birb: #0d050f;
		--rgb-bg-white: white;
		--rgb-text-birb: #ffffff;
		--rgb-a-birb: #f0ff9a;
		background-image: url(../../public/assets/img/birbs/lake.png);
        background-size: cover;
		font-family: 'Kalam', Arial, Helvetica, sans-serif;
		color: var(--rgb-text-birb);
        min-height: 100vh;
        & nav {
            display: flex;
            gap: 1rem;
            & button, a.button-like {
                all: unset; 
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 0.25em !important;
                outline: 0.2rem dotted var(--rgb-text-birb) !important;
                border-radius: 50%;
                cursor: pointer;
                &:hover {
                    transform: scale(1.1);
                }
                & img {
                    aspect-ratio: 1;
                    width: 1.25rem;
                }
            }
            
            & .dropdown-wrapper > div.dropdown.language-links {
                background-color: var(--rgb-bg-birb) !important;
            }
        }
        & .heading-wrapper {
            margin-bottom: 1rem;
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
            outline: 0.2rem dotted var(--rgb-text-birb) !important;
            border-radius: 1rem;

            & h1 {
                color: var(--rgb-text-birb);
                font-size: 2rem;
                padding: 0.5rem;;
                text-align: center;
                font-family: 'Kalam', Arial, Helvetica, sans-serif;
                font-weight: bold;
                margin: 0.5rem;
		    }
            & .inline-icon {
                width: 3em;
            }
        }
        & h2 {
            color: var(--rgb-text-birb);
            font-size: 1.5rem; 
        }
        & main {
            display: flex; flex-direction: column; align-items: center;
        }
        & section.card {
            display: flex;
            flex-direction: column;
            margin: 1rem;
            max-width: 1000px;
            align-items: center;
            justify-content: center;
            outline: 0.2rem dotted var(--rgb-text-birb) !important;
            border-radius: 1rem;
            padding: 1rem;
            & img.portrait {
                max-width: min(65vw, 800px);
                max-height: 50vw; 
                outline: 0.2rem solid var(--rgb-text-birb) !important;
                margin: 0.5rem;
                box-shadow: 0 0 0.5rem var(--rgb-text-birb);
            }
            & h2 {
                margin: 0.25rem;
                line-height: 1.25rem;
            }
            & h3 {
                margin: 0.25rem;
                line-height: 1.25rem;
            }
            & p {
                margin: 0.25rem;
                line-height: 1rem;
            }
        }
        & footer {
            margin-top: 1rem;
            display: flex;
            justify-content: center; align-items: center;
            gap: 0.5rem;
            & a.icon-link {
                all: unset;
                display: block;
                cursor: alias;
                &:hover {
                    transform: scale(1.1)
                }
                & img {
                    width: 2rem;
                    &.shift-down-a-bit {
                        transform: translateY(0.25rem);
                    }
                }
            }
        }
        
	}

    img { 
        user-select: none;
        image-rendering: optimizeSpeed;             /* STOP SMOOTHING, GIVE ME SPEED  */
        image-rendering: -moz-crisp-edges;          /* Firefox                        */
        image-rendering: -o-crisp-edges;            /* Opera                          */
        image-rendering: -webkit-optimize-contrast; /* Chrome (and eventually Safari) */
        image-rendering: pixelated;                 /* Universal support since 2021   */
        image-rendering: optimize-contrast;         /* CSS3 Proposed                  */
        -ms-interpolation-mode: nearest-neighbor;   /* IE8+                           */
    }
</style>