---
import { t, l } from 'astro-i18n';
import LingLayout from "../../layouts/LingLayout.astro";

import imgNishant from "../../../public/assets/img/nishant-standing-on-business.png"
import imgNoffle from "../../../public/assets/img/icons/ling-favicon-original.png"
import Banner from '../../components/Banner.astro';
---
<LingLayout webpTitle={t("linguistics.webp-title")} title={t("linguistics.h")}>
    <section class="intro"> 
        <div class="blurb">
            <p>
                {t("linguistics.intro.p")}
            </p>
        </div>
        <div class="portrait">
            <img src={imgNishant.src} alt="nishant suria portrait">
            <div class="label">Nishant Suria</div>
        </div>
    </section>
    <section class="works">
        <div class="projects">
            <h3>{t("linguistics.projects.h")}</h3>
            <ol>
                {[0, 1, 2, 3, 4].map((n) => 
                    <li>
                        <a href={l(t(`linguistics.projects.items.${n}.href`))}><b>{t(`linguistics.projects.items.${n}.title`)}</b></a>
                        <div>{t(`linguistics.projects.items.${n}.desc`)}</div>
                        <div><i>{t(`linguistics.projects.items.${n}.topics`)}</i></div>
                    </li> 
                )}
            </ol>
        </div>
        <div class="education">
            <h3>{t("linguistics.education.h")}</h3>
            <ol>
                {[0, 1].map((n) => 
                    <li>
                        <div><b>{t(`linguistics.education.items.${n}.title`)}</b></div>
                        <div>{t(`linguistics.education.items.${n}.desc`)}</div>
                        <div><i>{t(`linguistics.education.items.${n}.date`)}</i></div>
                    </li> 
                )}
            </ol>
            <h3>{t("linguistics.certs.h")}</h3>
            <ol>
                {[0, 1].map((n) => 
                    <li>
                        <div><b>{t(`linguistics.certs.items.${n}.title`)}</b></div>
                        <div><i>{t(`linguistics.certs.items.${n}.date`)}</i></div>
                    </li> 
                )}
            </ol>
        </div>
    </section>
    <section class="further-info">
        <div class="main-bit">
            <div class="blurb">
                <h3>Linguist FAQs</h3>
            </div>
            <div class="sidebar">
                <div class="see-also">
                    <h3>{t("linguistics.see-also.h")}</h3>
                    <ol>
                        {[0, 1].map((n) => 
                            <li>
                                <div><a href={l(t(`linguistics.see-also.items.${n}.href`))}><b>{t(`linguistics.see-also.items.${n}.title`)}</b></a></div>
                                <div><i>{t(`linguistics.see-also.items.${n}.desc`)}</i></div>
                            </li> 
                        )}
                    </ol>
                </div>
                <div class="noffles">
                    <div class="noffle-wrapper">
                        <img src={imgNoffle.src} alt="">
                    </div>
                    <div>{t("linguistics.noffles.blurbs.0")}</div>
                    <div class="noffle-wrapper">
                        <img src={imgNoffle.src} alt="">
                        <img src={imgNoffle.src} alt="">
                    </div>
                    <div>{t("linguistics.noffles.blurbs.1")}</div>
                </div>
            </div>
        </div>
        <div class="banners">
            <Banner key="lemon"/>
            <Banner key="plastic-love"/>
            <Banner key="wug"/>
            <Banner key="99-luftballons"/>
            <Banner key="vocaloid"/>
            <Banner key="praat"/>
		</div>
    </section>
</LingLayout>
<style>
    section {
        &.intro {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            margin: 1rem 0;
            align-items: center; justify-content: center;
            & .blurb {
                flex: 2;
                min-width: 20rem;
                & p {
                    all: unset;
                    font-size: 1.25rem;
                }
            } 
            & .portrait {
                flex: 1;
                text-align: center;
                & img {
                    border: var(--rgb-text-linguistics) 0.25rem dotted;
                    width: max(250px, 20vw);
                    aspect-ratio: 1;
                }
            }
        }
        &.works, .see-also {
            display: flex;
            gap: 0.5rem; 
            & > div {
                outline: 0.1rem var(--rgb-text-linguistics) dashed;
                padding: 0.5rem;
                &.projects {
                    flex: 2;
                }
                &.education {
                    flex: 1;
                }
            }
            & h2, h3 {
                font-size: 1.25rem;
            }
            & ol {
                list-style-type: devanagari;
                margin-block-start: 0.5rem;
                padding-inline-start: 1rem;
                & li {
                    margin: 0.5rem;
                }
                & a {
                    all: unset;
                    color: var(--rgb-a-linguistics);
                    text-decoration: underline;
                    cursor: pointer;
                    display: block;
                    &:hover {
                        transform: scale(1.05);
                    }
                }
            }
        }
        &.further-info {
            margin: 0.5rem 0;
            & .main-bit {
                display: flex;
                gap: 0.5rem;
            }
            & .blurb {
                flex: 3;
            }
            & .sidebar {
                flex: 1;
                display: flex;
                flex-direction: column;
                gap: 0.5rem;
                & > * {
                    outline: 0.1rem var(--rgb-text-linguistics) dashed;
                    padding: 0.5rem;  
                }
                & .see-also {
                    display: block; 
                    
                }
                & .noffles {
                    padding: 1rem;
                    display: flex;
                    flex-direction: column;
                    gap: 0.5rem;
                    text-align: center;
                    & .noffle-wrapper {
                        display: flex;
                        justify-content: center; align-items: center;
                    }
                }
            }
            & .banners {
                margin: 1rem 0;
                display: flex;
                align-items: center;
                justify-content: center;
            }
           
        }
    }
    h3 {
        margin: 0.5rem 0;
    }
</style>