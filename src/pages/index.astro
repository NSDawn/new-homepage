---
import { l, t } from 'astro-i18n';
import HomeLayout from "../layouts/HomeLayout.astro";
import DaysSinceLast from '../components/DaysSinceLast.astro';
import WikipediaLink from '../components/WikipediaLink.astro';
import BusinessCard from '../components/BusinessCard.astro';
import OsError from '../components/OsError.astro';
import OsStyle from '../auxstyles/OsStyle.astro';
import LanguageDropdown from '../components/LanguageDropdown.astro';
import { formatShortDate } from '../lib/locale'
---
<HomeLayout>
	<OsStyle />
	<section class="title">
		<h1>{t("home.h1")}</h1>
	</section>
	<section class="card intro">
		<div class="banners">
			<a href="https://en.wikipedia.org/wiki/World_Wide_Web">
				<img src="/assets/img/banners/www.gif" alt="banner gif displaying World Wide Web">
			</a>
			<a href="https://www.w3schools.com/html/">
				<img src="/assets/img/banners/no-ai.png" alt="banner gif displaying site created without AI">
			</a>
			<a href="https://en.wikipedia.org/wiki/CSS">
				<img src="/assets/img/banners/css.gif" alt="banner gif displaying made with CSS">
			</a>
			<a href="https://astro.build/">
				<img src="/assets/img/banners/astro.gif" alt="banner gif displaying astro">
			</a>
			<a href="https://www.vta.org/">
				<img src="/assets/img/banners/vta.png" alt="">
			</a>
			<a href="https://en.wiktionary.org/wiki/https://finance.yahoo.com/quote/GLD/?guccounter=1&guce_referrer=aHR0cHM6Ly93d3cuZ29vZ2xlLmNvbS8">
				<img src="/assets/img/banners/gold.gif" alt="">
			</a>
			<a href="https://en.wiktionary.org/wiki/wug">
				<img src="/assets/img/banners/wug.gif" alt="">
			</a>
			<a href="https://www.growmilkweedplants.com/map?srsltid=AfmBOopKI4SgX2HcgLJ6q9VRLYT4iVnaEJJxi0YrjvK_j_JP-Zn9hCg0">
				<img src="/assets/img/banners/milkweed.gif" alt="">
			</a>
			
		</div>
		<div class="intro-wrapper">
			<div class="blurb">
				<h2>
					{t("home.intro.h")}
				</h2>
				<p>
					{t("home.intro.p")}
				</p>
				<div class="quick-links">
					<h3>{t("home.intro.quick-links.h")}</h3>
					<ul>
						<li><a href={l("/linguistics")}>{t("home.intro.quick-links.linguistics")}</a></li>
						<li><a href="https://nsdawn.dev/games">{t("home.intro.quick-links.game-dev")}</a></li>
						<li><a href="https://nsdawn.dev/404">{t("home.intro.quick-links.fun")}</a></li>
					</ul>
				</div>
			</div>
			<LanguageDropdown />
			<div class="keep-scrolling">
				<img src="/assets/img/handmouse.gif" alt="">
				<div>{t("home.intro.keep-scrolling")}</div>
			</div>
		</div>
	</section>
	<section class="card web-dev">
		<h2>{t("home.web-dev.h")}</h2>
		<noscript>{t("home.web-dev.no-script")}</noscript>
		<div class="logos">
			<a href="https://www.typescriptlang.org/" target="_blank">
				<img src="/assets/img/svg-logos/typescript.svg" alt="typescript logo">
			</a>
			<a href="https://react.dev/" target="_blank">
				<img src="/assets/img/svg-logos/react.svg" alt="react logo">
			</a>
			<a href="https://angular.dev/" target="_blank">
				<img src="/assets/img/svg-logos/angular.svg" alt="angular logo">
			</a>
			<a href="https://astro.build/" target="_blank">
				<img src="/assets/img/svg-logos/astro.svg" alt="astro logo">
			</a>
		</div>
		<div class="sub-card-wrapper">
			<div class="sub-card accent1 card1 collapsed">
				<h3 onclick="toggleCollapsible('div.sub-card.card1')"><div class="indicator"></div><span>{t("home.web-dev.1.h")}</span></h3>
				<p class="collapsible">
					Lorem ipsum dolor sit amet consectetur adipisicing elit. Fugit error autem nemo laborum perspiciatis velit natus nobis assumenda rem animi placeat odio vel voluptatum explicabo adipisci, repellendus, vitae expedita mollitia.
				</p>
			</div>
			<div class="sub-card accent2 card2 collapsed">
				<h3 onclick="toggleCollapsible('div.sub-card.card2')"><div class="indicator"></div><span>{t("home.web-dev.2.h")}</span></h3>
				<p class="collapsible">
					Lorem ipsum dolor sit amet consectetur adipisicing elit. Fugit error autem nemo laborum perspiciatis velit natus nobis assumenda rem animi placeat odio vel voluptatum explicabo adipisci, repellendus, vitae expedita mollitia.
				</p>
			</div>
		</div>
		
		<a href={l("/cv")} class="check-out">
			<div class="label">
				{t("home.web-dev.check-out")}
			</div>
			<div class="arrow">
				→
			</div>	
		</a>
	</section>
	<section class="card linguistics">
		<h2><a href={l("/linguistics")}>{t("home.linguistics.h")}</a></h2>
		<div class="banners">
			<a href="https://www.youtube.com/watch?v=SX_ViT4Ra7k">
				<img src="/assets/img/banners/lemon.gif" alt="">
			</a>
			<a href="https://www.youtube.com/watch?v=T_lC2O1oIew">
				<img src="/assets/img/banners/plasticlove.gif" alt="">
			</a>
			<a href="https://en.wiktionary.org/wiki/wug">
				<img src="/assets/img/banners/wug.gif" alt="">
			</a>
			<a href="https://www.youtube.com/watch?v=Fpu5a0Bl8eY&list=RDFpu5a0Bl8eY&start_radio=1">
				<img src="/assets/img/banners/99luftballons.gif" alt="">
			</a>
			<a href="https://www.youtube.com/watch?v=sjGK_jWADRE">
				<img src="/assets/img/banners/vocaloid.gif" alt="">
			</a>
			<a href="https://www.fon.hum.uva.nl/praat/">
				<img src="/assets/img/banners/praat.png" alt="">
			</a>
		</div>
		<p>{t("linguistics.intro.p")}</p>
		<ol>
			{[0, 1, 2].map((n) => 
				<li>
					<a href={l(t(`linguistics.projects.items.${n}.href`))}><b>{t(`linguistics.projects.items.${n}.title`)}</b></a>
					<div>{t(`linguistics.projects.items.${n}.desc`)}</div>
					<div><i>{t(`linguistics.projects.items.${n}.topics`)}</i></div>
				</li> 
			)}
        </ol>
		<p>
            <img src="/assets/img/icons/ling-favicon-original.png" alt="noffle icon">
			<a href={l("/linguistics")}>
				{t("home.linguistics.go-to")}
			</a>
		</p>
	</section>
	<section class="business-card">
		<BusinessCard />
	</section>
	<section class="os-error">
		<OsError 
			title={t("home.os-error.h")} 
			blurb={t("home.os-error.p")} 
			imgSrc="/assets/img/question.gif"
			buttonTexts={[t("home.os-error.button1"), t("home.os-error.button2")]}
			buttonEffects={[null, null]}
		/>
	</section>
	<section class="card game-dev">
		<div class="banners">
			<a href="https://scryfall.com/card/j22/269/amoeboid-changeling">
				<img src="/assets/img/banners/changeling.gif" alt="">
			</a>
			<a href="https://scryfall.com/card/2xm/118/blood-moon">
				<img src="/assets/img/banners/blood-moon.png" alt="">
			</a>

			<a href="https://scryfall.com/card/f05/11/counterspell">
				<img src="/assets/img/banners/in-response.gif" alt="">
			</a>
			<a href="https://stardewvalleywiki.com/Maru">
				<img src="/assets/img/banners/maru.gif" alt="">
			</a>
			<a href="https://en.wikipedia.org/wiki/Grass">
				<img src="/assets/img/banners/minionans.gif" alt="">
			</a>
			<a href="https://subnautica.fandom.com/wiki/Peeper">
				<img src="/assets/img/banners/peeper.gif" alt="">
			</a>
			<a href="https://en.wikipedia.org/wiki/Project_Hail_Mary">
				<img src="/assets/img/banners/amaze-amaze-amaze.png" alt="">
			</a>
			
			
		</div>
	</section>
	<section class="card weird-bit">
		<h1>無我夢中</h1>
		<p>Lorem ipsum dolor, sit amet consectetur adipisicing elit. Harum modi alias non laudantium esse dolore voluptatem minus dolorum repellendus veritatis magnam fugiat nihil amet sapiente voluptatibus eaque, facilis, enim ab.</p>
	</section>
	<section class="card footer">
		<div class="last-updated">
			{formatShortDate(new Date(), t("common.lang"))}
		</div>
	</section>

</HomeLayout>
<script is:inline>
function toggleCollapsible(query) {
	const e = document.querySelector(query);
	if (e) {
		e.classList.toggle("collapsed");
	}
}
</script>
<style is:global>
main {
	height: 100vh;
	width: 100vw;
	overflow: hidden scroll;
	scrollbar-width: none;
}
& h1, h2, h3, h4 {
	text-align: center;
	font-family: Audiowide;
	line-height: 1em;
	margin: 0;
}
& h1 {
	text-shadow: var(--rgb-radical-magenta) 0.02em 0.02em, var(--rgb-radical-orange) -0.02em -0.02em;

	font-size: 6rem;
	position: sticky;
	font-family: Audiowide;
	top: 12.5vw;
}
section.title {
	height: 90vh;
	display: flex; align-items: center; justify-content: center;
	animation: float 15s infinite linear;
}
section.business-card {
	display: flex;
	align-items: center; justify-content: center;
}
section.os-error {
	display: flex;
	align-items: center; justify-content: center;
}
div.banners {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	justify-content: center;
}
section.card {
	background: var(--rgb-bg-card);
	text-shadow: var(--rgb-bg) 0.05em 0.05em;
	padding: 1rem;
	position: relative;
	& h2 {
		font-size: 2rem;
		font-family: Audiowide;
		text-align: left;
		margin: 1rem 0;
	}
	&.intro {
		& div.intro-wrapper {
			display: flex; 
			margin: 1rem 0;
			flex-direction:row;
			flex-wrap: wrap;
			align-items: center; justify-content: center;
			gap: 1rem;
			& div.blurb {
				max-width: 40rem;
				& div.quick-links {
					& h3 {
						text-align: left;
						
					}
					& ul {
						margin: 0.5rem;
						display: flex;
						gap: 2rem;
						& a {
							all: unset;
							cursor: alias;
							&:hover {
								text-decoration: underline var(--rgb-text) 0.05rem;
							}
						}
						& li {
							list-style: url('/assets/img/cat2.gif') disc;
							margin: 1rem;
							&:hover {
								transform: scale(1.1);
							}
						}
					}
				}
			}
			& div.keep-scrolling {
				align-self: end;
				display:flex; 
				flex-direction: row; 
				gap: 1rem; align-items: center; justify-content: left;

				& img {
					width: 4rem;
				}
			}
		}
	}
	&.linguistics {
		--rgb-bg-linguistics: #0000c8;
		--rgb-bg-white: white;
		--rgb-text-linguistics: #ccccff;
		--rgb-a-linguistics: #f0ff9a;
		background-color: var(--rgb-bg-linguistics);
		font-family: 'Times New Roman', Times, serif;
		outline: var(--rgb-text-linguistics) solid 0.25rem;
		color: var(--rgb-text-linguistics);
		& h2 {
			color: var(--rgb-text-linguistics);
			outline: var(--rgb-text-linguistics) double 0.25rem;
			padding: 0.5rem;;
			text-align: center;
			font-family: 'Times New Roman', Times, serif;
		}
		& a {
			all: unset;
			text-decoration: underline;
			cursor: pointer;
			&:hover {
				color: var(--rgb-a-linguistics);
			}
		}
	}
	&.weird-bit {
		
		background: url(/assets/img/katy-city.png);
		background-attachment: fixed;
	}
	&.web-dev {
		--rgb-bg-web-dev: #ffffff;
		--rgb-bg-web-dev-accent1: #f9baba;
		--rgb-bg-web-dev-accent2: #9fcdff;
		--rgb-bg-white: white;
		--rgb-text-web-dev: #525252;
		--rgb-text-web-dev-accent1: #670000;
		--rgb-text-web-dev-accent2: #03264c;
		--rgb-h-web-dev: #000000;
		--rgb-a-web-dev: #f0ff9a;
		--rgb-error-web-dev: #ff5132;
		background-color: var(--rgb-bg-web-dev);
		background-position: right center;
		background-image: url("/assets/img/objects.svg");
		background-repeat: no-repeat;
		animation: bg-float 30s infinite linear;
		padding: 2rem;
		font-family: NotoSans;
		color: var(--rgb-text-web-dev);
		text-shadow: none;
		box-shadow: 0 0 2rem var(--rgb-h-web-dev);
		transition: ease-in-out 0.25s;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		& h2, h3, h4 {
			font-family: Montserrat;
			color: var(--rgb-h-web-dev);
			font-weight: 200;
		}
		& h2 { 
			font-size: 3rem;

		}
		& .sub-card-wrapper {
			display: flex;
			align-items: flex-start; justify-content: center;
			gap: 3rem;
			& .sub-card {
				flex: 1;
				border-radius: 4rem;
				overflow: hidden;
				
				& h3 {
					margin: 2rem;
					text-align: left;
					font-size: 1.75rem;
					cursor: pointer;
					& div.indicator {
						display: inline-block;
						width: 1rem;
						margin: 0 1rem;
						font-size: 2rem;
						transition: ease-in-out 0.25s;
						transform: rotate(0deg);
	
					}
					& div.indicator::before {
						content: "-";
					}
				}
				p {
					margin: 0;
					padding: 2rem;
					padding-top: 0;
					overflow: hidden;
					transition: ease-in-out 0.25s;

				}
			}
			& .sub-card.collapsed {
				& h3 > div.indicator {
					transform: rotate(180deg);
					&::before {
						content: "+";
					}
				}
				& p.collapsible {
					height: 0;
					padding: 0;
					font-size: 0;
					filter: opacity(0);
				}
			}
			& .accent1 {
				background: var(--rgb-bg-web-dev-accent1);
				color: var(--rgb-text-web-dev-accent1);
				& h3 {
					color: var(--rgb-text-web-dev-accent1);
				}
			}
			& .accent2 {
				background: var(--rgb-bg-web-dev-accent2);
				color: var(--rgb-text-web-dev-accent2);
				& h3 {
					color: var(--rgb-text-web-dev-accent2);
				}
			}
		}
		& .check-out {
			all: unset;
			display: flex;
			gap: 0.25rem;
			cursor: pointer;
			&:hover {
				& .label {
					text-decoration: underline;
					font-weight: bold;
				} 
				& .arrow {
					transform: translateX(0.5rem);
				}
			}
			& .label {	
				transition: ease-in-out 0.25s;
			}
			& .arrow {
				transition: ease-in-out 0.25s;
			}
		}
		& .logos {
			display: flex;
			place-content: center center;
			gap: 0.5rem;
			& > a {
				flex: 1;
				all: unset;
				cursor: pointer;
				& > img {
					height: 2rem;
					transition: ease-in-out 0.25s;
					filter: opacity(0.8);
					&:hover {
						transform: scale(1.1);
					}
				}
			}
		}
		& noscript {
			color: var(--rgb-error-web-dev);
		}
	}
}

section.os-style {
	& .window1 {
		width: 50vw;
	}
}


</style>
