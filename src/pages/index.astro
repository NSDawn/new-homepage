---
import { l, t } from 'astro-i18n';
import HomeLayout from "../layouts/HomeLayout.astro";
import DaysSinceLast from '../components/DaysSinceLast.astro';
import WikipediaLink from '../components/WikipediaLink.astro';
import BusinessCard from '../components/BusinessCard.astro';
import OsError from '../components/OsError.astro';
import OsStyle from '../auxstyles/OsStyle.astro';
import LanguageDropdown from '../components/LanguageDropdown.astro';
import { formatShortDate } from '../lib/locale'
import Banner from '../components/Banner.astro';

import imgHello from "../../public/assets/img/chalkboard.gif";
import imgHandMouse from "../../public/assets/img/handmouse.gif";
import imgAkatsukiIcon from "../../public/assets/img/icons/akatsuki-brightened.png";
import imgQuestion from "../../public/assets/img/question.gif";
import imgCat2 from "../../public/assets/img/cat2.gif";
import imgObjects from "../../public/assets/img/objects.svg";
import imgKatyCity from "../../public/assets/img/katy-city.png";

import imgTypescriptLogo from "../../public/assets/img/svg-logos/typescript.svg"
import imgReactLogo from "../../public/assets/img/svg-logos/react.svg"
import imgAngularLogo from "../../public/assets/img/svg-logos/angular.svg"
import imgAstroLogo from "../../public/assets/img/svg-logos/astro.svg"

import imgNoffle from "../../public/assets/img/icons/ling-favicon-original.png"

import imgBluePrince from "../../public/assets/img/blue-prince.jpg"
import imgChantsOfSenaar from "../../public/assets/img/chants-of-senaar.png"
import imgObraDinn from "../../public/assets/img/return-of-the-obra-dinn.webp"
import imgForgottenCity from "../../public/assets/img/the-forgotten-city.jpg"
import imgGhostTrick from "../../public/assets/img/ghost-trick.jpg"
import { path } from '../utils/PathUtils.astro';
const coolGameImages = [imgBluePrince, imgChantsOfSenaar, imgObraDinn, imgForgottenCity, imgGhostTrick];
---
<HomeLayout>
	<OsStyle />
	<div class="corner-buttons-wrapper">
		<LanguageDropdown />
	</div>
	<section class="title">
		<h1>{t("home.h1")}</h1>
	</section>
	<section class="card intro">
		<div class="banners">
           	<Banner key="lemon"/>
            <Banner key="plastic-love"/>
            <Banner key="wug"/>
            <Banner key="99-luftballons"/>
            <Banner key="vocaloid"/>
            <Banner key="praat"/>
		
		</div>
		<div class="intro-wrapper">
			<div class="blurb">
				<h2>
					{t("home.intro.h")}
				</h2>
				<p>
					{t("home.intro.p")}
				</p>
				<div class="quick-links">
					<h3>{t("home.intro.quick-links.h")}</h3>
					<ul>
						<li><a href={l("/linguistics")}>{t("home.intro.quick-links.linguistics")}</a></li>
						<li><a href="https://nsdawn.dev/games">{t("home.intro.quick-links.game-dev")}</a></li>
						<li><a href="https://nsdawn.dev/404">{t("home.intro.quick-links.fun")}</a></li>
					</ul>
				</div>
			</div>
			<img src={imgHello.src} alt="hello">
		</div>
		<div class="keep-scrolling">
			<img src={imgHandMouse.src} alt="keep-scrolling">
			<div>{t("home.intro.keep-scrolling")}</div>
		</div>
	</section>
	<section class="card web-dev">
		<h2>{t("home.web-dev.h")}</h2>
		<noscript>{t("home.web-dev.no-script")}</noscript>
		<div class="logos">
			<a href="https://www.typescriptlang.org/" target="_blank">
				<img src={imgTypescriptLogo.src} alt="typescript logo">
			</a>
			<a href="https://react.dev/" target="_blank">
				<img src={imgReactLogo.src} alt="react logo">
			</a>
			<a href="https://angular.dev/" target="_blank">
				<img src={imgAngularLogo.src} alt="angular logo">
			</a>
			<a href="https://astro.build/" target="_blank">
				<img src={imgAstroLogo.src} alt="astro logo">
			</a>
		</div>
		<div class="sub-card-wrapper">
			<div class="sub-card accent1 card1 collapsed" onclick="toggleCollapsible('div.sub-card.card1')">
				<h3><div class="indicator"></div><span>{t("home.web-dev.1.h")}</span></h3>
				<p class="collapsible">
					Lorem ipsum dolor sit amet consectetur adipisicing elit. Fugit error autem nemo laborum perspiciatis velit natus nobis assumenda rem animi placeat odio vel voluptatum explicabo adipisci, repellendus, vitae expedita mollitia.
				</p>
			</div>
			<div class="sub-card accent2 card2 collapsed" onclick="toggleCollapsible('div.sub-card.card2')">
				<h3><div class="indicator"></div><span>{t("home.web-dev.2.h")}</span></h3>
				<p class="collapsible">
					Lorem ipsum dolor sit amet consectetur adipisicing elit. Fugit error autem nemo laborum perspiciatis velit natus nobis assumenda rem animi placeat odio vel voluptatum explicabo adipisci, repellendus, vitae expedita mollitia.
				</p>
			</div>
		</div>
		
		<a href={l("/cv")} class="check-out">
			<div class="label">
				{t("home.web-dev.check-out")}
			</div>
			<div class="arrow">
				→
			</div>	
		</a>
	</section>
	<section class="card linguistics">
		<h2><a href={l("/linguistics")}>{t("home.linguistics.h")}</a></h2>
		<div class="banners">
	        <Banner key="lemon"/>
            <Banner key="plastic-love"/>
            <Banner key="wug"/>
            <Banner key="99-luftballons"/>
            <Banner key="vocaloid"/>
            <Banner key="praat"/>
		</div>
		<p>{t("linguistics.intro.p")}</p>
		<ol>
			{[0, 1, 2].map((n) => 
				<li>
					<a href={l(t(`linguistics.projects.items.${n}.href`))}><b>{t(`linguistics.projects.items.${n}.title`)}</b></a>
					<div>{t(`linguistics.projects.items.${n}.desc`)}</div>
					<div><i>{t(`linguistics.projects.items.${n}.topics`)}</i></div>
				</li> 
			)}
        </ol>
		<p>
            <img src={imgNoffle.src} alt="noffle icon">
			<a href={l(path("linguistics"))}>
				{t("home.linguistics.go-to")}
			</a>
		</p>
	</section>
	<section class="business-card">
		<BusinessCard />
	</section>
	
	<section class="card game-dev">
		<div class="banners">
			<Banner key="changeling"/>
			<Banner key="blood-moon"/>
			<Banner key="in-response"/>
			<Banner key="maru"/>
			<Banner key="minionans"/>
			<Banner key="peeper"/>
			<Banner key="amaze-amaze-amaze"/>
			
		</div>
		<div class="cool-games">
			<h3>{t("home.game-dev.cool-games.h")}</h3>
			<div class="games">
				{[0, 1, 2, 3, 4].map((n) => 
					<a href={t(`home.game-dev.cool-games.games.${n}.href`)}>
						<img src={coolGameImages[n].src} alt={t(`home.game-dev.cool-games.games.${n}.alt`)} />
					</a>
				)}
			</div>
		</div>
	</section>
	<section class="card weird-bit">
		<div class="os-error">
			<OsError 
				title={t("home.os-error.h")} 
				blurb={t("home.os-error.p")} 
				imgSrc={imgQuestion.src}
				buttonTexts={[t("home.os-error.button1"), t("home.os-error.button2")]}
				buttonEffects={["goTo('./birb')", null]}
			/>
		</div>
		<h1>無我夢中</h1>
		<iframe data-testid="embed-iframe" style="border-radius:12px" src="https://open.spotify.com/embed/playlist/4PjAnMjrztwRf9mcwNJw4Q?utm_source=generator&si=321cc69bbd8e4c13" width="100%" height="352" frameborder="0" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
		<p>Lorem ipsum dolor, sit amet consectetur adipisicing elit. Harum modi alias non laudantium esse dolore voluptatem minus dolorum repellendus veritatis magnam fugiat nihil amet sapiente voluptatibus eaque, facilis, enim ab.</p>
	</section>
	<section class="card footer">
		<div class="last-updated">
			{formatShortDate(new Date(), t("common.lang"))}
		</div>
	</section>

</HomeLayout>
<script is:inline>
function toggleCollapsible(query) {
	const e = document.querySelector(query);
	if (e) {
		e.classList.toggle("collapsed");
	}
}
</script>
<style is:global>
main {
	height: 100vh;
	width: 100vw;
	overflow: hidden scroll;
	scrollbar-width: none;
}
& h1, h2, h3, h4 {
	text-align: center;
	font-family: Audiowide;
	line-height: 1em;
	margin: 0;
}
& h1 {
	text-shadow: var(--rgb-radical-magenta) 0.02em 0.02em, var(--rgb-radical-orange) -0.02em -0.02em;

	font-size: 6rem;
	position: sticky;
	font-family: Audiowide;
	top: 12.5vw;
}
section.title {
	height: 80vh;
	display: flex; align-items: center; justify-content: center;
	animation: float 15s infinite linear;
	
}
& .corner-buttons-wrapper {
	position: static;
	padding: 1rem;
}
section.business-card {
	display: flex;
	align-items: center; justify-content: center;
}
div.os-error {
	position: relative;
	text-shadow: none;
	right: 1rem;
	transform: rotate(15deg);
	display: flex;
	align-items: center; justify-content: center;
	& > div {
		width: 24rem;
	}
}
div.banners {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	justify-content: center;
}
section.card {
	background: var(--rgb-bg-card);
	text-shadow: var(--rgb-bg) 0.05em 0.05em;
	padding: 1rem;
	position: relative;
	& h2 {
		font-size: 2rem;
		font-family: Audiowide;
		text-align: left;
		margin: 1rem 0;
	}
	&.intro {
		--rgb-intro-bg: #000000;
		--rgb-intro-accent: #494949;
		--rgb-intro-text: #ffebc2;
		background-color: var(--rgb-intro-bg);
		background-image: url(../../public/assets/img/katytora.png);
		display: flex; 
		flex-direction:column;
		align-items: center; justify-content: center;
		background-size: 10%;
		& div.intro-wrapper {
			display: flex; 
			margin: 1rem 0;
			flex-direction:row;
			flex-wrap: wrap;
			align-items: center; justify-content: center;
			gap: 1rem;
			color: var(--rgb-intro-text);
			
			& div.blurb {
				outline: 0.25rem solid var(--rgb-intro-text);
				background: var(--rgb-intro-accent);
				padding:1rem;
				max-width: 40rem;
				& div.quick-links {
					& h3 {
						text-align: left;
						
					}
					& ul {
						margin: 0.5rem;
						display: flex;
						gap: 2rem;
						& a {
							all: unset;
							cursor: alias;
							&:hover {
								text-decoration: underline var(--rgb-text) 0.05rem;
							}
						}
						& li {
							list-style: url('../../public/assets/img/cat2.gif') disc;
							margin: 1rem;
							&:hover {
								transform: scale(1.1);
							}
						}
					}
				}
			}
		}
		& div.keep-scrolling {
			display: flex; 
			flex-direction: column;
				align-items: center; justify-content: center;

			& img {
				width: 4rem;
			}
		}
	}
	&.linguistics {
		--rgb-bg-linguistics: #0000c8;
		--rgb-bg-white: white;
		--rgb-text-linguistics: #ccccff;
		--rgb-a-linguistics: #f0ff9a;
		background-color: var(--rgb-bg-linguistics);
		font-family: 'Times New Roman', Times, serif;
		outline: var(--rgb-text-linguistics) solid 0.25rem;
		color: var(--rgb-text-linguistics);
		& h2 {
			color: var(--rgb-text-linguistics);
			outline: var(--rgb-text-linguistics) double 0.25rem;
			padding: 0.5rem;;
			text-align: center;
			font-family: 'Times New Roman', Times, serif;
		}
		& a {
			all: unset;
			text-decoration: underline;
			cursor: pointer;
			&:hover {
				color: var(--rgb-a-linguistics);
			}
		}
	}
	&.weird-bit {

		background: url(../../public/assets/img/katy-city.png);
		background-attachment: fixed;
	}
	&.web-dev {
		--rgb-bg-web-dev: #ffffff;
		--rgb-bg-web-dev-accent1: #f9baba;
		--rgb-bg-web-dev-accent2: #9fcdff;
		--rgb-bg-white: white;
		--rgb-text-web-dev: #525252;
		--rgb-text-web-dev-accent1: #670000;
		--rgb-text-web-dev-accent2: #03264c;
		--rgb-h-web-dev: #000000;
		--rgb-drop-shadow-web-dev: #00000033;
		--rgb-a-web-dev: #f0ff9a;
		--rgb-error-web-dev: #ff5132;
		background-color: var(--rgb-bg-web-dev);
		background-position: right center;
		background-image: url("../../public/assets/img/objects.svg");
		background-repeat: no-repeat;
		animation: bg-float 30s infinite linear;
		padding: 2rem;
		font-family: NotoSans;
		color: var(--rgb-text-web-dev);
		text-shadow: none;
		box-shadow: 0 0 2rem var(--rgb-h-web-dev);
		transition: ease-in-out 0.25s;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		& h2, h3, h4 {
			font-family: Montserrat;
			color: var(--rgb-h-web-dev);
			font-weight: 200;
		}
		& h2 { 
			font-size: 3rem;
			font-weight: 250;

		}
		& .sub-card-wrapper {
			display: flex;
			align-items: flex-start; justify-content: center;
			gap: 3rem;
			& .sub-card {
				flex: 1;
				border-radius: 4rem;
				overflow: hidden;
				cursor: pointer;
				transition: ease-in-out 0.25s;
				box-shadow: 0.25rem 0.25rem var(--rgb-drop-shadow-web-dev);
				&:hover {
					transform: rotate(2.5deg) scale(1.05);
				
				}
				&:hover:nth-child(2) {
					transform: rotate(-2.5deg) scale(1.05);
				}
				& h3 {
					margin: 2rem;
					text-align: left;
					font-size: 1.75rem;
					& div.indicator {
						display: inline-block;
						width: 1rem;
						margin: 0 1rem;
						font-size: 2rem;
						transition: ease-in-out 0.25s;
						transform: rotate(0deg);
	
					}
					& div.indicator::before {
						content: "-";
					}
				}
				p {
					margin: 0;
					padding: 2rem;
					padding-top: 0;
					overflow: hidden;
					transition: ease-in-out 0.25s;

				}
			}
			& .sub-card.collapsed {
				& h3 > div.indicator {
					transform: rotate(180deg);
					&::before {
						content: "+";
					}
				}
				& p.collapsible {
					height: 0;
					padding: 0;
					font-size: 0;
					filter: opacity(0);
				}
			}
			& .accent1 {
				background: var(--rgb-bg-web-dev-accent1);
				color: var(--rgb-text-web-dev-accent1);
				& h3 {
					color: var(--rgb-text-web-dev-accent1);
				}
			}
			& .accent2 {
				background: var(--rgb-bg-web-dev-accent2);
				color: var(--rgb-text-web-dev-accent2);
				& h3 {
					color: var(--rgb-text-web-dev-accent2);
				}
			}
		}
		& .check-out {
			all: unset;
			display: flex;
			gap: 0.25rem;
			cursor: pointer;
			&:hover {
				& .label {
					text-decoration: underline;
					font-weight: bold;
				} 
				& .arrow {
					transform: translateX(0.5rem);
				}
			}
			& .label {	
				transition: ease-in-out 0.25s;
			}
			& .arrow {
				transition: ease-in-out 0.25s;
			}
		}
		& .logos {
			display: flex;
			place-content: center center;
			gap: 0.5rem;
			& > a {
				flex: 1;
				all: unset;
				cursor: pointer;
				& > img {
					height: 2rem;
					transition: ease-in-out 0.25s;
					filter: opacity(0.8);
					&:hover {
						transform: scale(1.1);
					}
				}
			}
		}
		& noscript {
			color: var(--rgb-error-web-dev);
		}
	}
	&.game-dev {
		& .cool-games {
			& h3 {
				margin: 1rem;
			}
			& .games {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				align-items: center;
				gap: 2vw;
				& a {
					all:unset;
					cursor: pointer;
					padding: 0 0;
					&:hover {
						transform: scale(1.1);
					}
					& img {
						outline: var(--rgb-text) 0.1rem solid;
						aspect-ratio: 2;
						width: max(150px, 14vw);
					}
				}
			}
		}
	}
}

section.os-style {
	& .window1 {
		width: 50vw;
	}
}


</style>
